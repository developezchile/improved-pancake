# Variables de viajes-eventos-ui para Render (Static/Web Service de Node).
# NEXT_PUBLIC_* se incrusta al compilar: si cambia la URL de la API hay que volver a desplegar.
# En local no afecta: .env.local tiene prioridad sobre este archivo.
NEXT_PUBLIC_API_URL=https://viajes-eventos-api.onrender.com/api
